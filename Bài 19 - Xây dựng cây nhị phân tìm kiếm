
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* left;
    Node* right;
};

Node* createNode(int data) {
    Node* newNode = new Node();
    newNode->data = data;
    newNode->left = NULL;
    newNode->right = NULL;
    return newNode;
}


//mycode
void insertNode(Node*& root, Node* newNode){
    if(root == NULL){
        root = newNode;
        return;
    }
    if(newNode->data < root->data){
        insertNode(root->left, newNode);
    }else{
        insertNode(root->right,newNode);
    }
}
void inorder(Node* root){
    if(root == NULL) return;
    inorder(root->left);
    cout << root->data << " ";
    inorder(root->right);
}
//end


int main() {
    ios::sync_with_stdio(false);
    cin.tie(0);
    Node* root = NULL;
    int n;
    cin >> n;
    for (int i = 0; i < n; i++) {
        int data;
        cin >> data;
        insertNode(root, createNode(data));
    }
    inorder(root);
    cout << "\n";
    return 0;
}
